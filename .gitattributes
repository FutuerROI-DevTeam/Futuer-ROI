# Git must preserve the shebang of the portable pre-commit hook on Windows.
.githooks/* text eol=lf

# Docker smoke uses LF with Windows autocrlf as well.
scripts/smoke-compose.sh text eol=lf
scripts/smoke-today.sh text eol=lf
scripts/smoke-env.sh text eol=lf
scripts/tests/*.sh text eol=lf

# SQL checksum is computed from the executed text; keep checkout bytes portable.
apps/api/migrations/*.sql text eol=lf
