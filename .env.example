# Future ROIの環境設定の例。実値は入れず、空の項目名だけを示す。
# ローカルでは`.env`（Git除外）へコピーして値を入れる。`npm run dev:api`と`npm run db:*`が`.env`を読む。
# Engine単体のtypecheck/test/T-14・Docker検証とFoundation checkには全項目不要。

# APIのDB接続先（必須）。password等を含むためSecretとして扱う。
# ローカルCompose（compose.yaml）のDBへ接続する場合の形式: postgres://futureroi:<LOCAL_DB_PASSWORD>@127.0.0.1:55432/futureroi
# passwordに`%`・`#`・`?`・`@`等を含む場合はURI内でpercent-encodeする（例: `%`→`%25`）か、URIからpasswordを省いて
# PGPASSWORDへ生の値を入れる（pgはURIにpasswordがなければPGPASSWORDを使う）。
DATABASE_URL=

# Composeの開発用PostgreSQLのpassword（必須: compose起動時）。ローカル専用で、本番の値を入れない。
LOCAL_DB_PASSWORD=

# Composeのhost側port（任意）。既定はWeb/API=8080、DB=55432。公開は127.0.0.1だけ。
LOCAL_APP_PORT=
LOCAL_DB_PORT=

# APIの待受（任意）。既定はHOST=127.0.0.1、PORT=3000。コンテナ内では0.0.0.0/8080を既定にしている。
HOST=
PORT=

# ビルド済みSPAのディレクトリ（任意）。設定時はAPIが同一originで配信する。未設定ならAPIだけが起動する。
WEB_DIST=

# ログレベル（任意）。既定はinfo。
LOG_LEVEL=

# 認証（Better Auth）のSecret。本番とComposeでは必須・32文字以上。Compose用はユーザーがローカル専用値を設定する。
# 未設定の開発環境では apps/api/.local/auth-secret（Git除外）に自動生成する。生成例: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# 認証の公開base URL（例: https://<staging host>）。本番では必須でhttps。Cookieの Secure 属性とOrigin検査に使う。
# 未設定の開発環境では http://127.0.0.1:<PORT>。Composeはhttp://127.0.0.1:<LOCAL_APP_PORT>とHTTP許可を明示設定する。
# 公開HTTPS環境ではBETTER_AUTH_ALLOW_HTTPを設定しない（ローカルComposeの値を流用しない）。
BETTER_AUTH_URL=
BETTER_AUTH_ALLOW_HTTP=

# BETTER_AUTH_URL以外に認証と状態変更APIを許すorigin（任意、カンマ区切り）。開発環境では http://127.0.0.1:5173 等を自動で含める。
AUTH_TRUSTED_ORIGINS=

# 信頼するproxyのhop数（任意、既定0）。公開先でproxyを1段挟むなら1。client IP（回数制限の鍵）の決定に使う。
TRUST_PROXY_HOPS=

# 1 IPあたり60秒の試行上限（任意、既定5）。共有回線のデモ会場向けの上限はチームで合意して上書きする。
AUTH_SIGN_IN_MAX=
AUTH_SIGN_UP_MAX=
# パスワード再設定の要求・保存の、1 IPあたり60秒の上限（任意、既定5）。
AUTH_RESET_MAX=

# パスワード再設定メールの送信手段。resend（Resend HTTP API）か log（送らずサーバーログへ本文を出す）。
# 既定は本番（NODE_ENV=production）がresend、それ以外がlog。ComposeとsmokeはlogをCompose側で設定する。
# resendではRESEND_API_KEY（Secret）とMAIL_FROM（例: Future ROI <no-reply@example.com>、Resendで認証済みドメイン）が必須。
MAIL_TRANSPORT=
RESEND_API_KEY=
MAIL_FROM=

# #225 本人向け評価（既定OFF）。実データ有効化には説明・purge/backup運用の別判断が必要。
# EVALUATION_ENABLED=0 （未設定でもOFF。実利用の承認後だけ1を指定する）
# 有効時は保存値を作るbuildを識別。VercelではVERCEL_GIT_COMMIT_SHAも利用できる。
EVALUATION_BUILD_VERSION=
# 初期90日/90行/30暦日。上限90/90/30、retentionはobservation+2以上。
EVALUATION_RETENTION_DAYS=
EVALUATION_MAX_SNAPSHOTS=
EVALUATION_OBSERVATION_DAYS=
