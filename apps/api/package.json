{
  "name": "@futureroi/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Future ROI API (Fastify + TypeBox + PostgreSQL). Serves the built SPA from the same origin.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate-cli.ts all",
    "db:migrate:auth": "node --env-file-if-exists=../../.env src/db/migrate-cli.ts auth",
    "db:migrate:app": "node --env-file-if-exists=../../.env src/db/migrate-cli.ts app",
    "db:check": "node --env-file-if-exists=../../.env src/db/schema-check-cli.ts",
    "db:seed:demo": "node --env-file-if-exists=../../.env src/db/seed-demo-cli.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@fastify/type-provider-typebox": "6.1.0",
    "@futureroi/prediction": "0.0.0",
    "@sinclair/typebox": "0.34.52",
    "@vercel/functions": "3.9.11",
    "better-auth": "1.7.7",
    "fastify": "5.12.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "5.9.3"
  }
}
